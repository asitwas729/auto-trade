# ─────────────────────────────────────────────────────────────────
# 한국투자증권 Open API 설정
#
# 모의투자/실전투자 앱키는 KIS API 포털에서 별도 발급:
#   apiportal.koreainvestment.com -> 앱 등록 -> 모의/실전 각각 발급
# ─────────────────────────────────────────────────────────────────

# 모의투자 전용 (TRADING_MODE=mock 또는 paper)
KIS_MOCK_APP_KEY=모의투자_앱키
KIS_MOCK_APP_SECRET=모의투자_앱시크릿
KIS_MOCK_ACCOUNT_NO=00000000   # 모의투자 계좌번호 (8자리)

# 실전투자 전용 (TRADING_MODE=live)
KIS_REAL_APP_KEY=실전투자_앱키
KIS_REAL_APP_SECRET=실전투자_앱시크릿
KIS_REAL_ACCOUNT_NO=00000000   # 실전투자 계좌번호 (8자리)

KIS_ACCOUNT_PRODUCT=01         # 계좌상품코드 (일반: 01)

# 운영 모드: mock | paper | live
TRADING_MODE=mock

# 알림 (선택)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 초기 자본 (백테스트/페이퍼용, 단위: 원)
INITIAL_CAPITAL=10000000

# ─────────────────────────────────────────────────────────────────
# S5 뉴스 섹터 모멘텀 전략 설정
# ─────────────────────────────────────────────────────────────────

# Naver Open API (뉴스 수집 2순위 소스)
# 발급: https://developers.naver.com → 앱 등록 → 검색 API 활성화
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 (삼프로TV VOD 검증 스크립트 전용)
# 발급: https://console.cloud.google.com → YouTube Data API v3 활성화 → API 키 생성
# 무료 할당량: 하루 10,000 units (검색 100 units, 검증 30일 = ~3,000 units)
YOUTUBE_API_KEY=AIzaSyDFUgkKjCxWWokpEBsJ9swmeo8zH4otNpk
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx   # 삼프로TV 채널 ID

# S5 전략 ON/OFF (기본 true)
STRATEGY_S5_ENABLED=true
